cd ~/penn_ngs_pipeline

cat > .gitignore <<'EOF'
# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Raw sequencing data
data/raw/
data/variant_demo/*.fastq
data/variant_demo/*.fastq.gz

# Large alignment files
*.bam
*.bai
*.sam
*.cram
*.crai

# Reference indexes
*.amb
*.ann
*.bwt
*.pac
*.sa
*.fai

# Temporary files
*.tmp
*.log
EOF
